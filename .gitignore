# ─── Third-party clones (re-fetched on demand, not vendored) ────────────
# atomic-red-team is 400+ MB of Red Canary's public test library.
# Clone fresh via: git clone https://github.com/redcanaryco/atomic-red-team
atomic-red-team/

# Caldera is the MITRE adversary-emulation framework. Same reasoning —
# huge, third-party, and it generates secrets at first boot (see below).
caldera/

# ─── Build artifacts (regenerated by scripts/compile.sh) ────────────────
# By convention we commit source rules, not compiled output. CI regenerates.
dist/

# ─── LocalStack runtime state (regenerated on first boot) ───────────────
# Caches, machine IDs, self-signed test certs — none of this is source.
Localstack/localstack-data/

# ─── Secrets ────────────────────────────────────────────────────────────
# Belt-and-braces: credentials.txt is inside caldera/ above, but list it
# explicitly in case anyone moves/copies it.
**/credentials.txt
*.env
.env
.env.*
*.pem
*.key
id_rsa*

# Kubeconfigs sometimes embed bearer tokens
kubeconfig
*.kubeconfig

# ─── Python venvs / build cruft ─────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ─── Editor / OS noise ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Claude Code session state (local-only) ─────────────────────────────
.claude/
